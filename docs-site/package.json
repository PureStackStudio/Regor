{
  "name": "regor-doc-site",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "purestack serve --content ./content --port 4400 --clean",
    "build": "purestack build --content ./content --clean",
    "publish": "purestack publish --content ./content",
    "deploy": "pgdeploy deploy --host https://regor.purestack.studio --package ./dist/web --allow-path 'pagefind/*,.ts-ssg/manifest.json' --skip-path '.purestack-output'"
  },
  "dependencies": {
    "@purestack/ts-components": "latest",
    "@purestack/ts-css": "latest",
    "@purestack/ts-html": "latest",
    "@purestack/ts-style": "latest",
    "@purestack/ts-util": "latest",
    "purestack": "latest",
    "regor": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "packageManager": "yarn@4.9.2"
}

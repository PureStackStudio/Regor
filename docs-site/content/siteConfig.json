{
  "$schema": "../node_modules/@purestack/ts-ssg/schema/siteConfig.schema.json",
  "siteTitle": "Regor",
  "favicon": "lucide:orbit",
  "logo": {
    "brand": "Regor",
    "icon": "lucide:orbit",
    "markStyle": "solid",
    "markBackground": "var(--ps-semantic-tone-accent-button-rest-background)",
    "markColor": "var(--ps-semantic-tone-accent-button-rest-text)",
    "href": "/",
    "ariaLabel": "Regor home",
    "suffix": "",
    "size": "md"
  },
  "style": {
    "themes": ["light", "dark"],
    "theme": {
      "skin": "regor"
    },
    "fileName": "site.css",
    "href": "/assets/site.css",
    "pretty": false
  },
  "navigation": {
    "mode": "hybrid",
    "navFileName": "_nav.json",
    "maxDepth": 3,
    "includeIndex": true,
    "sortBy": "order",
    "roots": ["guide", "directives", "api"],
    "variant": "spotlight",
    "class": "spotlight-from-bottom-right"
  },
  "pageToc": {
    "enabled": true
  },
  "pagefind": {
    "enabled": true,
    "excludePaths": []
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://regor.purestack.studio",
    "robots": {
      "enabled": true,
      "host": "regor.purestack.studio",
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": [],
      "crawlDelay": 2,
      "additionalSitemaps": [],
      "customDirectives": ["# Generated by PureStack"]
    },
    "fileName": "sitemap.xml"
  },
  "preview": {
    "title": "Regor | Small signals. Big possibilities.",
    "description": "A reactive UI library for TypeScript. Connect state to HTML and SVG, compose components, and update the DOM directly.",
    "siteName": "Regor",
    "image": "/assets/social-preview.png",
    "imageAlt": "Regor. Small signals. Big possibilities. Reactive UI for HTML and SVG, in chartreuse on graphite.",
    "imageWidth": 1200,
    "imageHeight": 630,
    "twitterCard": "summary_large_image"
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../dist/web-dev",
  "publishDir": "../dist/web",
  "auth": {
    "enabled": false,
    "signUp": false
  },
  "html": {
    "minify": true
  },
  "scripts": {
    "cacheBusting": true
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2026-10-07",
    "privacyPolicyUrl": "https://purestack.studio/legal/privacy/",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      }
    ],
    "services": []
  },
  "docLayout": {
    "sidebarTop": "5.5625rem",
    "sidebarTopMobile": "4.875rem"
  }
}
